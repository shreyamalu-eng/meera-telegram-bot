    "webhook-info": "node --env-file=.env scripts/webhook-info.js",
    "compare": "node --env-file=.env scripts/compare.js",
    "seed-voice": "node --env-file=.env scripts/seed-voice.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9"
  }
}
