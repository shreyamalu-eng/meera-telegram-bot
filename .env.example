# Copy this file to ".env" and fill in the values (for testing on your computer).
# Add the same values in Vercel: Project > Settings > Environment Variables.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any long random password you make up (letters, numbers, _ and - only)
TELEGRAM_WEBHOOK_SECRET=

# Meera's chat ID, so nobody else can use the bot. The bot tells you it when you send /start.
# Several IDs can be separated by commas. Leave empty to allow anyone (not recommended).
ALLOWED_CHAT_IDS=

# Optional: which Gemini model to use (default: gemini-3.6-flash)
GEMINI_MODEL=

# --- Memory (Supabase). Leave empty to run without saving anything. ---
# Supabase → Project Settings → API: the Project URL, and a Secret key (sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Drafting with Claude instead of Gemini ---
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only if Claude says the key "is not scoped to a workspace": Console → Settings → Workspaces → ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# "gemini" (default) or "claude"
DRAFT_PROVIDER=
# Optional: which Claude model to use (default: claude-sonnet-5)
CLAUDE_MODEL=
