# Copy this file to ".env" and fill in the values (for testing on your computer).
# Add the same values in Vercel: Project > Settings > Environment Variables.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any long random password you make up (letters, numbers, _ and - only)
TELEGRAM_WEBHOOK_SECRET=

# Meera's chat ID, so nobody else can use the bot. The bot tells you it when you send /start.
# Several IDs can be separated by commas. Leave empty to allow anyone (not recommended).
ALLOWED_CHAT_IDS=

# Optional: which Gemini model to use (default: gemini-3.6-flash)
GEMINI_MODEL=
